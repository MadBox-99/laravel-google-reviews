{
    "name": "cegem360/laravel-google-reviews",
    "description": "Fetch and display Google Places reviews in Laravel and Filament apps.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/console": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "filament/filament": "^4.0 || ^5.0"
    },
    "suggest": {
        "filament/filament": "Adds an admin settings page (^4.0 || ^5.0)."
    },
    "autoload": {
        "psr-4": {
            "Cegem360\\GoogleReviews\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cegem360\\GoogleReviews\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cegem360\\GoogleReviews\\GoogleReviewsServiceProvider"
            ],
            "aliases": {
                "GoogleReviews": "Cegem360\\GoogleReviews\\Facades\\GoogleReviews"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
