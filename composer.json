{
    "name": "madbox-99/laravel-google-reviews",
    "description": "Fetch and display Google Places reviews in Laravel and Filament apps.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "filament/filament": "^4.0 || ^5.0",
        "laravel/pint": "^1.0",
        "rector/rector": "^2.0",
        "driftingly/rector-laravel": "^2.0",
        "larastan/larastan": "^3.0"
    },
    "suggest": {
        "filament/filament": "Adds an admin settings page (^4.0 || ^5.0)."
    },
    "autoload": {
        "psr-4": {
            "Madbox99\\GoogleReviews\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Madbox99\\GoogleReviews\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Madbox99\\GoogleReviews\\GoogleReviewsServiceProvider"
            ],
            "aliases": {
                "GoogleReviews": "Madbox99\\GoogleReviews\\Facades\\GoogleReviews"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "pint": "pint",
        "rector": "rector process",
        "analyse": "phpstan analyse",
        "lint": [
            "@pint",
            "@rector",
            "@analyse"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}